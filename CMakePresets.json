{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 27,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_BUILD_TYPE": "Release",
        "GENERATE_TEST": true,
        "OUT_PATH": "${sourceDir}/cmake-build-${presetName}/bootstrapper",
        "DLL_NAME": "dwmapi.dll"
      }
    },
    {
      "name": "x64-ninja-clangcl",
      "displayName": "x64-ninja-clangcl",
      "description": "Compile for Windows x64 using Ninja and clang-cl",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "binaryDir": "${sourceDir}/cmake-build-${presetName}",
      "generator": "Ninja",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_C_FLAGS": "/nologo /EHsc /clang:-Wall /clang:-Wextra /clang:-Werror /clang:-m64 /clang:-O3 /clang:-march=native /WX- /Gy /clang:-flto=auto /clang:-fomit-frame-pointer /clang:-g0",
        "CMAKE_CXX_FLAGS": "/nologo /EHsc /clang:-Wall /clang:-Wextra /clang:-Werror /clang:-m64 /clang:-O3 /clang:-march=native /WX- /Gy /clang:-flto=auto /clang:-fomit-frame-pointer /clang:-g0",
        "CMAKE_SHARED_LINKER_FLAGS": "/subsystem:console /OPT:REF /OPT:ICF=3 /LTCG /DEBUG:NONE /EMITPOGOPHASEINFO /ERRORREPORT:QUEUE",
        "CMAKE_EXE_LINKER_FLAGS": "/subsystem:console /OPT:REF /OPT:ICF=3 /LTCG /DEBUG:NONE /EMITPOGOPHASEINFO /ERRORREPORT:QUEUE"
      }
    },
    {
      "name": "x64-vs2022-msvc",
      "displayName": "x64-vs2022-msvc",
      "description": "Compile for Windows x64 using Visual Studio 17 2022 and msvc",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "binaryDir": "${sourceDir}/cmake-build-${presetName}",
      "generator": "Visual Studio 17 2022",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_C_FLAGS": "/nologo /EHsc /O2 /Ob2 /Ot /Oy /Oi /GL /Gy /Gm- /MP /GS- /Gw",
        "CMAKE_CXX_FLAGS": "/nologo /EHsc /O2 /Ob2 /Ot /Oy /Oi /GL /Gy /Gm- /MP /GS- /Gw",
        "CMAKE_SHARED_LINKER_FLAGS": "/subsystem:console /OPT:REF /OPT:ICF=3 /LTCG /DEBUG:NONE /EMITPOGOPHASEINFO /ERRORREPORT:QUEUE",
        "CMAKE_EXE_LINKER_FLAGS": "/subsystem:console /OPT:REF /OPT:ICF=3 /LTCG /DEBUG:NONE /EMITPOGOPHASEINFO /ERRORREPORT:QUEUE"
      }
    },
    {
      "name": "x64-ninja-msvc-debug",
      "displayName": "x64-ninja-msvc-debug",
      "description": "Compile for Windows x64 using Visual Studio 17 2022 and msvc",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_BUILD_TYPE": "Debug",
        "GENERATE_TEST": true,
        "OUT_PATH": "${sourceDir}/cmake-build-${presetName}/bootstrapper",
        "DLL_NAME": "dwmapi.dll",
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_C_FLAGS": "/nologo /EHsc /MP /GS- /Zi",
        "CMAKE_CXX_FLAGS": "/nologo /EHsc /MP /GS- /Zi",
        "CMAKE_SHARED_LINKER_FLAGS": "/subsystem:console /ERRORREPORT:QUEUE",
        "CMAKE_EXE_LINKER_FLAGS": "/subsystem:console /ERRORREPORT:QUEUE"
      }
    },
    {
      "name": "x64-ninja-clang",
      "displayName": "x64-ninja-clang",
      "description": "Compile for Windows x64 using Ninja and clang",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "binaryDir": "${sourceDir}/cmake-build-${presetName}",
      "generator": "Ninja",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang",
        "CMAKE_C_FLAGS": "-O3 -g0 -march=native -flto=auto -fomit-frame-pointer -momit-leaf-frame-pointer -ffunction-sections -fdata-sections -Wall -Wextra -Werror",
        "CMAKE_CXX_FLAGS": "-O3 -g0 -march=native -flto=auto -fomit-frame-pointer -momit-leaf-frame-pointer -ffunction-sections -fdata-sections -Wall -Wextra -Werror"
      }
    },
    {
      "name": "x64-arm64-cross-compile",
      "displayName": "x64-arm64-cross-compile",
      "description": "Cross-Compile on Windows x64 for Windows arm64 using Ninja and clang-cl",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "binaryDir": "${sourceDir}/cmake-build-${presetName}",
      "generator": "Ninja",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_C_FLAGS": "/nologo /EHsc /clang:-Wall /clang:-Wextra /clang:-Werror /clang:-O3 /WX- /Gy /clang:-flto=auto /clang:-fomit-frame-pointer /clang:-g0",
        "CMAKE_CXX_FLAGS": "/nologo /EHsc /clang:-Wall /clang:-Wextra /clang:-Werror /clang:-O3 /WX- /Gy /clang:-flto=auto /clang:-fomit-frame-pointer /clang:-g0",
        "CMAKE_SHARED_LINKER_FLAGS": "/subsystem:console /OPT:REF /OPT:ICF=3 /LTCG /DEBUG:NONE /EMITPOGOPHASEINFO /ERRORREPORT:QUEUE",
        "CMAKE_EXE_LINKER_FLAGS": "/subsystem:console /OPT:REF /OPT:ICF=3 /LTCG /DEBUG:NONE /EMITPOGOPHASEINFO /ERRORREPORT:QUEUE",
        "CROSS_COMPILE_ARM64": true,
        "GENERATE_TEST": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-ninja-clang",
      "configurePreset": "x64-ninja-clang"
    }
  ],
  "testPresets": [
    {
      "name": "tests-release",
      "hidden": true,
      "configurePreset": "x64-ninja-clang",
      "description": "Run the Catch2 test suite via CTest",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "ci-testing",
      "steps": [
        {
          "type": "configure",
          "name": "x64-ninja-clang"
        },
        {
          "type": "build",
          "name": "x64-ninja-clang"
        },
        {
          "type": "test",
          "name": "tests-release"
        }
      ]
    }
  ]
}
